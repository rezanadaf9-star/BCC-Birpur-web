{
  "name": "bcc-portal",
  "private": true,
  "scripts": {
    "test:rules": "firebase emulators:exec --only firestore,storage \"mocha tests/rules/*.test.js --timeout 20000\"",
    "test:functions": "firebase emulators:exec --only auth,firestore,functions \"mocha functions/test/*.test.js --timeout 30000\"",
    "emulators": "firebase emulators:start"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "firebase": "^13.4.0",
    "firebase-tools": "^15.37.0",
    "mocha": "^12.0.3"
  }
}
